@using Bluegrass.Application.ViewModels.Blocks
@model HeroBlockViewModel
@{
    var image = Model.Image;
}

<div class="hero-block">
    <h2>Hero Block</h2>
    <p>Title: @Model.Title</p>
    <p>Description: @Model.Description</p>
    @if (image != null)
    {
        <img src="@image.Url()" alt="@image.Name" />
    }
</div>